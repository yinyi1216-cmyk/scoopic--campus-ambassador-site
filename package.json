    "deploy:worker": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "devDependencies": {
    "wrangler": "4.124.0"
  }
}
